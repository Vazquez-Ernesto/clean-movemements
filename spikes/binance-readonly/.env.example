# Copiá este archivo como .env (no se sube al repositorio) y completá tus datos.
# La key debe ser de SOLO LECTURA. Si tiene cualquier otro permiso, el spike se detiene.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Opcionales
# SPIKE_LOOKBACK_DAYS=90        # días de depósitos, retiros y Convert a consultar (1 a 365)
# SPIKE_SYMBOLS=BTCUSDT,USDTARS # pares a consultar en myTrades; si se omite, se deducen
# SPIKE_MAX_SYMBOLS=30
# SPIKE_MAX_TRADE_PAGES=20      # páginas de 1000 trades por par
# BINANCE_BASE_URL=https://api.binance.com
