# Copiá este archivo como .env (no se sube al repositorio) y completalo.
# Access Token de PRODUCCIÓN (empieza con APP_USR-) de una aplicación tuya en
# Mercado Pago Developers. Da acceso a tu cuenta: no lo compartas con nadie.
MP_ACCESS_TOKEN=

# Opcional: tu número de usuario de Mercado Pago, para saber si la búsqueda
# devuelve pagos que recibiste, que hiciste o ambos. No sale en el reporte.
# MP_USER_ID=

# Opcionales
# SPIKE_SEARCH_DAYS=60            # días de pagos a buscar (1 a 365)
# SPIKE_REPORT_DAYS=30            # días de cada reporte (1 a 60)
# SPIKE_REPORTS=settlement,release  # vacío para no generar reportes
# SPIKE_POLL_SECONDS=15
# SPIKE_REPORT_TIMEOUT_MINUTES=10
# SPIKE_MAX_SEARCH_PAGES=20       # páginas de 50 pagos
